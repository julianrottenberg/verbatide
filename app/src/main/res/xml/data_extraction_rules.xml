<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing Verbatide writes is worth backing up off the device: transcripts,
  retained dictation audio and the diagnostic log are all sensitive, and the API
  keys live in files that cannot be decrypted after a restore anyway.

  `allowBackup="false"` covers most paths, but Android 12+ device-to-device
  transfer does not always honour it, so both domains are excluded explicitly.
  The file domain is rooted at filesDir(), so paths are relative to it.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="phonewhisper.xml" />
        <exclude domain="sharedpref" path="phonewhisper_secure.xml" />
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="transcription_history.json" />
        <exclude domain="file" path="verbatide.log" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="phonewhisper.xml" />
        <exclude domain="sharedpref" path="phonewhisper_secure.xml" />
        <exclude domain="file" path="recordings/" />
        <exclude domain="file" path="transcription_history.json" />
        <exclude domain="file" path="verbatide.log" />
    </device-transfer>
</data-extraction-rules>
